  "commands": {
    "run_tests": "$env:PYTHONIOENCODING='utf-8'; python -m unittest discover -s tests",
    "sync_known_words": "python scripts/sync_known_words.py --limit 5000",
    "build_external_agent_vocab_bundle": "python scripts/build_external_agent_vocab_bundle.py",
    "check_external_agent_vocab_bundle": "python scripts/build_external_agent_vocab_bundle.py --check",
    "sync_marcel_personal_known_words": "python scripts/sync_personal_known_words.py --profile data/learner_profiles/marcel --core data/known_words.txt",
    "validate_marcel_with_known_character_compounds": "python scripts/validate_book.py --known data/known_words.txt --personal-known data/learner_profiles/marcel/personal_known_words.txt --known-character-compounds --known-character-compound-limit 1000 --chapters manuscripts/<slug>/chapters --out manuscripts/<slug>/vocabulary_report.json",
    "validate_sample_book": "python scripts/validate_book.py --known data/known_words.txt --chapters manuscripts/sample-known-words/chapters --out manuscripts/sample-known-words/vocabulary_report.json",
    "check_series_memory_update": "python scripts/check_series_memory_update.py --manuscript manuscripts/<slug> --series-dir series/an-lin",
    "generate_agent_indexes": "python scripts/build_agent_index.py",
    "publish_completed_work": "git status --short; git add -A; git commit -m \"<concise change summary>\"; git push origin <current-branch>"
