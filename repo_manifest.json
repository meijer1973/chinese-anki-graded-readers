    "default_branch": "main",
    "raw_base_url": "https://raw.githubusercontent.com/meijer1973/chinese-anki-graded-readers/main/",
    "purpose": "Chinese Anki deck tooling plus controlled-vocabulary Chinese graded-reader fiction generation."
  },
  "freshness_rule": "Refresh RESEARCH_AGENT_MAP.md, AGENT_GITHUB_ENTRY.md, reports/url-index.md, and reports/github-agent-index.md whenever repository paths, workflows, scripts, skills, agents, or manuscript conventions change. Commit and push accepted tracked work to origin before calling it done unless the user explicitly says not to or Git/validation blocks publication.",
  "default_vocabulary_policy": {
    "min_known_token_percent": 98,
    "max_approved_non_core_token_percent": 2,
    "max_easy_character_compound_token_percent": 95,
    "easy_character_compound_limit": 500,
    "easy_character_compounds_path": "data/learner_profiles/marcel/high_frequency_characters.txt",
    "soft_difficulty_targets": "Use some rank 2501-5000 known words and some character compounds requiring character ranks 501-1000 when natural; this is not a hard gate.",
    "approved_non_core_layers": [
      "general_fiction_stretch",
      "genre_stretch",
      "setting_stretch",
      "profession_stretch",
      "journalism_crime_stretch",
      "business_economics_stretch",
      "book_specific_stretch",
      "proper_noun"
    ],
    "max_forbidden_unknown_tokens_per_chapter": 5
  },
